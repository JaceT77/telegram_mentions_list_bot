# Copy to .env and fill in real values. Never commit .env.

# Telegram API credentials: https://my.telegram.org -> API development tools
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# Bot token from @BotFather
BOT_TOKEN=123456789:AAExampleTokenExampleTokenExampleTo

# Encrypts the local Telegram database in data/. Any long random string.
# Changing it later means logging in again.
DATABASE_ENCRYPTION_KEY=change-me-to-a-long-random-string

# Optional. DEBUG logs every incoming message (without its text) to help troubleshooting.
# LOG_LEVEL=INFO
